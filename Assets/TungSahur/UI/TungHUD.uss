/* Tung Sahur HUD — restrained, Elden Ring inspired: thin framed bars, serif headings, quiet gold. */

.hud-root {
    flex-grow: 1;
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    color: rgb(237, 230, 214);
    font-size: 18px;
}

/* ---------------------------------------------------------------- status bars */
.status {
    position: absolute;
    left: 64px;
    top: 52px;
}

.bar {
    margin-bottom: 7px;
    padding: 2px;
    background-color: rgba(10, 11, 14, 0.78);
    border-width: 1px;
    border-color: rgba(216, 180, 106, 0.55);
    border-radius: 1px;
}

.bar__inner {
    flex-grow: 1;
    background-color: rgba(30, 30, 34, 0.9);
    overflow: hidden;
}

.bar__chip, .bar__fill, .bar__shine {
    position: absolute;
    left: 0; top: 0; bottom: 0;
}

.bar__chip { background-color: rgb(232, 194, 122); width: 100%; }
.bar__fill { width: 100%; }
.bar__shine {
    right: 0;
    height: 40%;
    background-color: rgba(255, 255, 255, 0.10);
}

.bar--hp .bar__fill { background-color: rgb(179, 40, 45); }
.bar--fp .bar__fill { background-color: rgb(58, 111, 216); }
.bar--st .bar__fill { background-color: rgb(62, 158, 90); }
.bar--st .bar__chip { background-color: rgb(150, 200, 140); }
.bar--fp .bar__chip { background-color: rgb(150, 180, 240); }

/* ---------------------------------------------------------------- equipment cross */
.equip {
    position: absolute;
    left: 70px;
    bottom: 70px;
    width: 196px;
    height: 196px;
}

.equip__slot {
    position: absolute;
    width: 72px;
    height: 72px;
    background-color: rgba(10, 11, 14, 0.62);
    border-width: 1px;
    border-color: rgba(216, 180, 106, 0.35);
    rotate: 45deg;
    align-items: center;
    justify-content: center;
}

.equip__slot--up    { left: 62px;  top: 6px; }
.equip__slot--left  { left: 6px;   top: 62px; }
.equip__slot--right { left: 118px; top: 62px; }
.equip__slot--down  { left: 62px;  top: 118px; }
.equip__slot--active {
    border-color: rgba(244, 223, 166, 0.85);
    background-color: rgba(30, 24, 16, 0.75);
}

.equip__icon {
    width: 86px;
    height: 86px;
    rotate: -45deg;
    -unity-background-scale-mode: scale-to-fit;
}

.equip__empty {
    rotate: -45deg;
    color: rgba(237, 230, 214, 0.35);
}

.equip__name {
    position: absolute;
    left: 268px;
    bottom: 128px;
    font-size: 19px;
    color: rgb(244, 223, 166);
    -unity-text-outline-width: 0.6px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.8);
    letter-spacing: 2px;
}

/* ---------------------------------------------------------------- lock-on reticle */
.reticle {
    position: absolute;
    width: 0;
    height: 0;
}

.reticle__dot {
    position: absolute;
    left: -5px; top: -5px;
    width: 10px; height: 10px;
    border-radius: 5px;
    background-color: rgb(255, 250, 236);
}

.reticle__ring {
    position: absolute;
    left: -16px; top: -16px;
    width: 32px; height: 32px;
    border-radius: 16px;
    border-width: 2px;
    border-color: rgba(255, 250, 236, 0.55);
}

/* ---------------------------------------------------------------- enemy bars */
.enemy-layer {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}

.ebar {
    position: absolute;
    width: 160px;
    flex-direction: row;
    align-items: center;
}

.ebar__frame {
    width: 160px;
    height: 8px;
    background-color: rgba(10, 10, 12, 0.85);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.9);
    overflow: hidden;
}

.ebar__chip, .ebar__fill {
    position: absolute;
    left: 0; top: 0; bottom: 0;
}

.ebar__chip { background-color: rgb(232, 194, 122); }
.ebar__fill { background-color: rgb(166, 32, 36); }

.ebar__dmg {
    position: absolute;
    left: 168px;
    top: -10px;
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(246, 231, 193);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.85);
    transform-origin: left center;
}

.ebar__tag {
    position: absolute;
    left: 0;
    top: -30px;
    font-size: 16px;
    letter-spacing: 3px;
    color: rgb(255, 181, 71);
    -unity-text-outline-width: 0.8px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.9);
    opacity: 0;
}

/* ---------------------------------------------------------------- control hints */
.hints {
    position: absolute;
    right: 56px;
    bottom: 56px;
    padding: 16px 18px 12px 18px;
    background-color: rgba(8, 9, 12, 0.55);
    border-left-width: 2px;
    border-color: rgba(216, 180, 106, 0.6);
    transition-property: opacity, translate;
    transition-duration: 0.35s;
    transition-timing-function: ease-out-cubic;
}

.hints--collapsed .hints__list .hint { display: none; }
.hints--collapsed .hints__list .hint--toggle { display: flex; }
.hints--collapsed .hints__title { display: none; }
.hints--collapsed { background-color: rgba(8, 9, 12, 0.35); padding: 8px 12px 6px 12px; }

.hints__title {
    font-size: 17px;
    letter-spacing: 4px;
    color: rgb(244, 223, 166);
    margin-bottom: 8px;
}

.hint {
    flex-direction: row;
    align-items: center;
    margin-bottom: 5px;
}

.hint__label { font-size: 15px; color: rgb(237, 230, 214); }
.hint__label--dim { color: rgb(154, 146, 127); }

.glyph {
    min-width: 34px;
    padding: 1px 8px 2px 8px;
    margin-right: 10px;
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(20, 18, 14);
    background-color: rgb(226, 214, 188);
    border-radius: 9px;
}

.glyph--small { font-size: 11px; min-width: 28px; }

/* ---------------------------------------------------------------- felled banner */
.banner {
    position: absolute;
    left: 0; right: 0;
    top: 38%;
    height: 120px;
    align-items: center;
    justify-content: center;
}

.banner__band {
    position: absolute;
    left: 0; right: 0; top: 18px; bottom: 18px;
    background-color: rgba(0, 0, 0, 0.55);
}

.banner__text {
    font-size: 58px;
    color: rgb(232, 200, 120);
    letter-spacing: 12px;
    -unity-text-outline-width: 0.5px;
    -unity-text-outline-color: rgba(60, 40, 10, 0.9);
    text-shadow: 0 0 18px rgba(255, 190, 90, 0.75);
}

/* ---------------------------------------------------------------- title */
.title {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(4, 6, 10, 0.72);
    align-items: center;
    justify-content: center;
}

.title__vignette-unused {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    border-width: 220px;
    border-color: rgba(0, 0, 0, 0.35);
}

.title__col { align-items: center; }

.title__kicker {
    font-size: 20px;
    letter-spacing: 8px;
    color: rgb(154, 146, 127);
    margin-bottom: 10px;
}

.title__main {
    font-size: 92px;
    letter-spacing: 14px;
    color: rgb(237, 230, 214);
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.9);
}

.title__sub {
    font-size: 140px;
    letter-spacing: 40px;
    margin-top: -4px;
    color: rgb(232, 200, 120);
    text-shadow: 0 0 34px rgba(255, 181, 71, 0.55);
}

.title__rule {
    width: 520px;
    height: 1px;
    margin: 18px 0 26px 0;
    background-color: rgba(216, 180, 106, 0.6);
}

.title__prompt {
    font-size: 20px;
    letter-spacing: 6px;
    color: rgb(237, 230, 214);
}

/* ---------------------------------------------------------------- pause */
.pause {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(4, 6, 10, 0.72);
    align-items: center;
    justify-content: center;
}

.pause__frame {
    width: 1180px;
    height: 640px;
    padding: 36px 48px 24px 48px;
    background-color: rgba(12, 13, 17, 0.97);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgba(216, 180, 106, 0.55);
}

.pause__head {
    font-size: 30px;
    letter-spacing: 10px;
    color: rgb(244, 223, 166);
    margin-bottom: 26px;
}

.pause__body {
    flex-grow: 1;
    flex-direction: row;
}

.pause__menu {
    width: 300px;
    border-right-width: 1px;
    border-color: rgba(216, 180, 106, 0.25);
    padding-right: 20px;
}

.pause__item {
    font-size: 24px;
    padding: 10px 16px;
    margin-bottom: 4px;
    color: rgb(154, 146, 127);
    border-left-width: 3px;
    border-color: rgba(0, 0, 0, 0);
    transition-property: color, background-color, translate;
    transition-duration: 0.15s;
}

.pause__item--active {
    color: rgb(244, 223, 166);
    background-color: rgba(216, 180, 106, 0.10);
    border-color: rgb(216, 180, 106);
    translate: 6px 0;
}

.pause__panel {
    flex-grow: 1;
    padding-left: 40px;
}

.pause__foot {
    flex-direction: row;
    justify-content: flex-end;
    border-top-width: 1px;
    border-color: rgba(216, 180, 106, 0.2);
    padding-top: 12px;
}

.pause__footnote { font-size: 15px; color: rgb(154, 146, 127); letter-spacing: 2px; }

.panel__flavor { font-size: 28px; color: rgb(244, 223, 166); margin-bottom: 18px; white-space: normal; }
.panel__text { font-size: 19px; color: rgb(237, 230, 214); white-space: normal; margin-bottom: 12px; }
.panel__text--dim { color: rgb(154, 146, 127); }

.controls-grid { }
.controls-row {
    flex-direction: row;
    align-items: center;
    padding: 5px 0;
    border-bottom-width: 1px;
    border-color: rgba(255, 255, 255, 0.05);
}
.controls-row--head .controls-cell { color: rgb(244, 223, 166); font-size: 15px; letter-spacing: 2px; }
.controls-cell { width: 220px; flex-direction: row; font-size: 16px; }
.controls-cell--label { width: 340px; color: rgb(237, 230, 214); }

.setting {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
    margin-bottom: 4px;
    border-left-width: 3px;
    border-color: rgba(0, 0, 0, 0);
}

.setting--active {
    background-color: rgba(216, 180, 106, 0.10);
    border-color: rgb(216, 180, 106);
}

.setting__name { font-size: 20px; }
.setting__value-box { flex-direction: row; align-items: center; }
.setting__value { width: 90px; -unity-text-align: middle-center; font-size: 20px; color: rgb(244, 223, 166); }
.setting__arrow { font-size: 22px; color: rgb(154, 146, 127); }

/* ---------------------------------------------------------------- bow crosshair */
.crosshair {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
}

.crosshair__dot {
    position: absolute;
    left: -3.5px; top: -3.5px;
    width: 7px; height: 7px;
    border-radius: 3.5px;
    background-color: rgb(255, 250, 236);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.55);
}

.crosshair__tick {
    position: absolute;
    background-color: rgb(255, 250, 236);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.45);
}

.crosshair__tick--v { left: -2px; top: -8px; width: 4px; height: 16px; border-radius: 1px; }
.crosshair__tick--h { left: -8px; top: -2px; width: 16px; height: 4px; border-radius: 1px; }

.crosshair__hit {
    position: absolute;
    left: 0; top: 0;
    width: 0; height: 0;
}

.crosshair__hit-arm {
    position: absolute;
    left: -1.5px; top: -24px;
    width: 3px; height: 10px;
    transform-origin: 1.5px 24px;
    background-color: rgb(255, 247, 230);
}

.equip__ammo {
    position: absolute;
    left: 14px;
    top: 118px;
    font-size: 22px;
    color: rgb(244, 223, 166);
    -unity-text-outline-width: 0.6px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.8);
}

/* ---------------------------------------------------------------- boss bar (bottom centre) */
.bossbar {
    position: absolute;
    left: 50%;
    bottom: 92px;
    width: 980px;
    translate: -490px 0;
}

.bossbar__name {
    font-size: 24px;
    letter-spacing: 2px;
    color: rgb(237, 230, 214);
    margin-bottom: 4px;
    -unity-text-outline-width: 0.6px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.9);
}

.bossbar__frame {
    height: 13px;
    background-color: rgba(10, 8, 10, 0.88);
    border-width: 1px;
    border-color: rgba(216, 180, 106, 0.55);
    overflow: hidden;
}

.bossbar__chip, .bossbar__fill {
    position: absolute;
    left: 0; top: 0; bottom: 0;
}

.bossbar__chip { background-color: rgb(232, 194, 122); }
.bossbar__fill { background-color: rgb(150, 26, 30); }
.bossbar__shine {
    position: absolute;
    left: 0; right: 0; top: 0;
    height: 4px;
    background-color: rgba(255, 255, 255, 0.08);
}

.bossbar__dmg {
    position: absolute;
    right: 0;
    top: 2px;
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(246, 231, 193);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.85);
    transform-origin: right center;
}

/* ---------------------------------------------------------------- YOU DIED + screen fade */
.death {
    position: absolute;
    left: 0; right: 0;
    top: 40%;
    height: 150px;
    align-items: center;
    justify-content: center;
}

.death__band {
    position: absolute;
    left: 0; right: 0; top: 24px; bottom: 24px;
    background-color: rgba(0, 0, 0, 0.7);
}

.death__text {
    font-size: 92px;
    letter-spacing: 6px;
    color: rgb(150, 18, 22);
    -unity-text-outline-width: 0.5px;
    -unity-text-outline-color: rgba(40, 0, 0, 0.9);
    text-shadow: 0 0 22px rgba(160, 10, 10, 0.6);
}

.screenfade {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgb(0, 0, 0);
}

/* ---------------------------------------------------------------- F1 debug: boss roster */
.dbg {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(4, 6, 10, 0.55);
    align-items: flex-start;
    justify-content: flex-start;
    padding: 150px 0 0 56px;   /* clear of the status bars */
}

.dbg__frame {
    width: 620px;
    padding: 22px 28px 16px 28px;
    background-color: rgb(12, 13, 17);   /* opaque: world-space enemy bars sit underneath */
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgba(216, 180, 106, 0.55);
}

.dbg__head {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    padding-bottom: 12px;
    margin-bottom: 10px;
    border-bottom-width: 1px;
    border-color: rgba(216, 180, 106, 0.2);
}
.dbg__title { font-size: 24px; letter-spacing: 8px; color: rgb(244, 223, 166); }
.dbg__tag { font-size: 13px; letter-spacing: 3px; color: rgb(154, 146, 127); }

.dbg__row {
    flex-direction: row;
    align-items: center;
    padding: 9px 14px;
    margin-bottom: 3px;
    border-left-width: 3px;
    border-color: rgba(0, 0, 0, 0);
    transition-property: background-color, translate;
    transition-duration: 0.12s;
}
.dbg__row--active {
    background-color: rgba(216, 180, 106, 0.10);
    border-color: rgb(216, 180, 106);
    translate: 4px 0;
}
.dbg__row--all { margin-top: 8px; }

.dbg__key {
    width: 28px;
    font-size: 14px;
    color: rgb(154, 146, 127);
    -unity-text-align: middle-left;
}
.dbg__col { flex-grow: 1; }
.dbg__name { font-size: 20px; color: rgb(237, 230, 214); }
.dbg__row--active .dbg__name { color: rgb(244, 223, 166); }
.dbg__status { font-size: 14px; color: rgb(154, 146, 127); margin-top: 2px; }
.dbg__row--on .dbg__status { color: rgb(196, 92, 84); }
.dbg__action {
    font-size: 14px;
    letter-spacing: 2px;
    color: rgb(154, 146, 127);
    -unity-text-align: middle-right;
}
.dbg__row--active .dbg__action { color: rgb(244, 223, 166); }
.dbg__empty { font-size: 16px; color: rgb(154, 146, 127); padding: 9px 14px; white-space: normal; }

.dbg__foot {
    margin-top: 12px;
    padding-top: 10px;
    border-top-width: 1px;
    border-color: rgba(216, 180, 106, 0.2);
    font-size: 13px;
    letter-spacing: 1px;
    color: rgb(154, 146, 127);
}

/* ---------------------------------------------------------------- mask slots (1-4 / D-pad) */
.maskbar {
    position: absolute;
    left: 70px;
    bottom: 290px;
    width: 220px;
    height: 70px;
    flex-direction: row;
    transition-property: opacity;
    transition-duration: 0.3s;
}

.maskbar__slot {
    width: 38px;
    height: 38px;
    margin: 7px 7px 0 7px;
    background-color: rgba(10, 11, 14, 0.55);
    border-width: 1px;
    border-color: rgba(216, 180, 106, 0.22);
    rotate: 45deg;
    align-items: center;
    justify-content: center;
}

.maskbar__slot--owned { border-color: rgba(216, 180, 106, 0.6); }
.maskbar__slot--worn {
    border-color: rgb(196, 214, 88);
    background-color: rgba(52, 60, 22, 0.8);
    border-width: 2px;
}

.maskbar__icon {
    width: 46px;
    height: 46px;
    rotate: -45deg;
    -unity-background-scale-mode: scale-to-fit;
}

.maskbar__key {
    position: absolute;
    top: 50px;
    width: 40px;
    font-size: 12px;
    -unity-text-align: middle-center;
    color: rgba(237, 230, 214, 0.7);
    -unity-text-outline-width: 0.4px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.8);
}

/* ---------------------------------------------------------------- cinematic overlays */
.letterbox {
    position: absolute;
    left: 0; right: 0;
    height: 0;
    background-color: rgb(0, 0, 0);
}
.letterbox--top { top: 0; }
.letterbox--bottom { bottom: 0; }

.whiteflash {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgb(255, 250, 236);
}

.maskcard {
    position: absolute;
    left: 0; right: 0;
    bottom: 15%;
    height: 170px;
    align-items: center;
    justify-content: center;
}

.maskcard__band {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.6);
}

.maskcard__title {
    font-size: 54px;
    color: rgb(204, 214, 104);
    letter-spacing: 12px;
    -unity-text-outline-width: 0.5px;
    -unity-text-outline-color: rgba(30, 40, 10, 0.9);
}

.maskcard__line {
    margin-top: 6px;
    font-size: 19px;
    -unity-text-align: middle-center;
    color: rgb(237, 230, 214);
}

.maskcard__hint {
    margin-top: 10px;
    font-size: 15px;
    color: rgb(216, 180, 106);
}

/* long sword spirit gauge (Shark Mask) */
.bar--spirit { padding: 1px; }
.bar--spirit .bar__fill { background-color: rgb(158, 199, 219); }
.bar--spirit .bar__chip { background-color: rgb(220, 236, 244); }
.spirit__pips { position: absolute; right: -40px; top: 0px; flex-direction: row; }
.spirit__pip { width: 8px; height: 8px; margin-left: 3px; border-width: 1px; border-color: rgba(216, 178, 107, 0.6); rotate: 45deg; background-color: rgba(26, 26, 30, 0.8); }
